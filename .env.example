# Copy these into Vercel > Project > Settings > Environment Variables.

# Required for the enquiry form. Get it at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are emailed. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=digital.solutions.wc@gmail.com

# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email your Resend account uses. Once you verify your own domain in
# Resend, set this to e.g. "Digital Solutions WC <hello@yourdomain.co.za>".
CONTACT_FROM_EMAIL=

# Optional. Your live URL once you have a custom domain (used for SEO tags).
NEXT_PUBLIC_SITE_URL=
