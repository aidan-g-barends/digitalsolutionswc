# Copy these into Vercel > Project > Settings > Environment Variables.

# Required for the enquiry form. Get it at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are emailed. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=digital.solutions.wc@gmail.com

# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email your Resend account uses. Once you verify your own domain in
# Resend, set this to e.g. "Digital Solutions WC <hello@yourdomain.co.za>".
CONTACT_FROM_EMAIL=

# Optional. Your live URL once you have a custom domain (used for SEO tags).
NEXT_PUBLIC_SITE_URL=

# ── AI assistant ───────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# Optional. Default gemini-2.5-flash. Use gemini-2.5-flash-lite for more free messages per day.
GEMINI_MODEL=

# ── Database (leads, bookings, admin) ──────────────────────────
# Supabase > Project Settings > API. Run supabase/setup.sql in the SQL Editor first.
SUPABASE_URL=
# The SECRET service role key. Server only, never shown to visitors.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar (optional) ─────────────────────────────────
# Lets bookings check your real calendar and appear in it. See README for the 5-minute setup.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
